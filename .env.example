# Copia questo file in ".env" (NON committare .env: è in .gitignore) e
# valorizza i valori. Servono SOLO per la build cloud lato server, così il
# visitatore deve solo incollare l'URL e l'APK viene compilato in automatico.

# Personal Access Token GitHub con scope "repo" e "workflow".
# RESTA SEGRETO: vive solo sul server (Netlify → Site settings → Environment variables),
# mai esposto al browser e mai committato.
WEBTOAPP_GITHUB_TOKEN=

# Repository dove girano le build, formato "utente/repo".
WEBTOAPP_GITHUB_REPO=jeaders/WebToApp

# (Opzionale, solo in sviluppo locale) URL del build hook Netlify per il deploy.
# Su GitHub Actions si usa il secret NETLIFY_BUILD_HOOK_URL, non questa variabile.
# NETLIFY_BUILD_HOOK_URL=
